{
  "rules": {
    ".read": false,
    ".write": false,

    "responses": {
      ".read": "auth != null && auth.token.email == 'admin@unknown-world.app'",
      ".indexOn": ["createdAt", "moderationStatus", "kstDate"],
      "$responseId": {
        ".write": "auth != null && (auth.token.email == 'admin@unknown-world.app' || (auth.token.email == 'worker@unknown-world.app' && newData.exists()))"
      }
    },

    "publicResponses": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$responseId": {
        ".write": "auth != null && (auth.token.email == 'admin@unknown-world.app' || (auth.token.email == 'worker@unknown-world.app' && !data.exists() && newData.exists()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['question','createdAt']) && newData.child('question').isString() && newData.child('question').val().length > 0 && newData.child('question').val().length <= 70 && newData.child('createdAt').isNumber())"
      }
    }
  }
}
